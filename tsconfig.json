{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": false,
    "types": [
      "chrome"
    ]
  },
  "include": [
    "extension/lib/**/*.js",
    "extension/content/**/*.js",
    "extension/tags/**/*.js",
    "types/**/*.d.ts"
  ]
}
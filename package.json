{
  "name": "gog-enhancer-tests",
  "private": true,
  "type": "module",
  "description": "Test harness for the GOG Enhancer extension. The extension itself ships as plain vanilla JS — this package.json exists only so contributors can run vitest against the pure utility modules.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.pages-popup.json && tsc --noEmit -p tsconfig.pages-onboarding.json && tsc --noEmit -p tsconfig.pages-options.json",
    "e2e": "node e2e/extension.e2e.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:e2e": "node scripts/verify.mjs --e2e",
    "verify:full": "node scripts/verify.mjs --full",
    "e2e:upgrade": "node e2e/upgrade.mjs",
    "e2e:backup": "node e2e/backup-compat.mjs",
    "e2e:locales": "node e2e/locales.mjs",
    "e2e:pages": "node e2e/pages-sweep.mjs",
    "e2e:a11y": "node e2e/a11y-deep.mjs",
    "e2e:soak": "node e2e/soak.mjs",
    "e2e:resilience": "node e2e/markup-resilience.mjs",
    "e2e:sw": "node e2e/sw-reliability.mjs",
    "e2e:bigbackup": "node e2e/big-backup.mjs",
    "e2e:zip": "node e2e/zip-check.mjs",
    "e2e:structure": "node e2e/structure.mjs",
    "build:firefox": "node scripts/build-firefox.mjs",
    "lint:firefox": "node scripts/build-firefox.mjs --no-zip && npx --yes web-ext@latest lint -s dist/firefox"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.18.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.14.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
